---
/**
 * Calendar — client-side list / month views over the events dataset.
 *
 * The markup is server-rendered so the page is useful without JavaScript
 * (crawlers and no-JS visitors see a complete, correctly-grouped list). The
 * inline script then re-derives statuses against the visitor's actual clock,
 * because a static build freezes `new Date()` at build time.
 *
 * Every date computation uses local Date parts — never toISOString() — since
 * the data is plain YYYY-MM-DD with no timezone. See lib/calendar.ts.
 */
import type { CalendarEvent } from "../lib/calendar";
import { dayKey, toDate, getAllEvents, getVerifiedOn } from "../lib/calendar";

interface Props {
  events?: CalendarEvent[];
  /** Build-time date, used for the initial server-rendered status. */
  today: string;
}

const { events = getAllEvents(), today } = Astro.props;
const verifiedOn = getVerifiedOn();

const CATEGORY_LABEL: Record<string, string> = {
  food: "Food",
  coffee: "Coffee",
  market: "Market",
  family: "Family",
  music: "Music",
  exhibition: "Exhibition",
  crafts: "Crafts",
};

/** Categories actually present, ordered by frequency. */
const categoryCounts = new Map<string, number>();
for (const e of events) {
  for (const c of e.categories) {
    categoryCounts.set(c, (categoryCounts.get(c) ?? 0) + 1);
  }
}
const categories = [...categoryCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([key, count]) => ({ key, count, label: CATEGORY_LABEL[key] ?? key }));

/** Every calendar day an event occupies. */
function daysOf(ev: CalendarEvent): Date[] {
  const out: Date[] = [];
  const start = toDate(ev.start);
  const end = toDate(ev.end);
  for (let d = new Date(start); d <= end; d.setDate(d.getDate() + 1)) {
    out.push(new Date(d));
  }
  return out;
}

function statusOf(ev: CalendarEvent, now: string) {
  const t = toDate(now);
  const s = toDate(ev.start);
  const e = toDate(ev.end);
  if (e < t) return "past";
  if (s <= t && t <= e) return "live";
  const days = Math.round((s.getTime() - t.getTime()) / 86400000);
  return days <= 7 ? "soon" : "future";
}

const STATUS_LABEL = {
  live: "On now",
  soon: "This week",
  future: "Upcoming",
  past: "Ended",
} as const;

const fmtDay = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "long" });
const fmtWeekday = (d: Date) =>
  d.toLocaleDateString("en-GB", { weekday: "long" });

/** "1–4 October" / "28 September – 2 October", collapsing a shared month. */
function fmtRange(a: Date, b: Date): string {
  if (dayKey(a) === dayKey(b)) return fmtDay(a);
  const sameMonth =
    a.getMonth() === b.getMonth() && a.getFullYear() === b.getFullYear();
  return sameMonth ? `${a.getDate()}–${fmtDay(b)}` : `${fmtDay(a)} – ${fmtDay(b)}`;
}

/* ---- server-side grouping (mirrors the client logic exactly) ---- */
const t = toDate(today);
const upcoming: Array<{ key: string; events: CalendarEvent[] }> = [];
const ended: CalendarEvent[] = [];
const bucket = new Map<string, CalendarEvent[]>();

for (const e of events) {
  const s = toDate(e.start);
  const en = toDate(e.end);
  if (en < t) {
    ended.push(e);
    continue;
  }
  const key = s < t ? today : dayKey(s);
  const list = bucket.get(key);
  if (list) list.push(e);
  else bucket.set(key, [e]);
}
for (const [key, list] of [...bucket.entries()].sort((a, b) =>
  a[0].localeCompare(b[0])
)) {
  upcoming.push({ key, events: list });
}
ended.sort((a, b) => toDate(b.start).getTime() - toDate(a.start).getTime());

const liveCount = events.filter((e) => statusOf(e, today) === "live").length;
const nowCount = events.filter((e) => statusOf(e, today) !== "past").length;

/** Serialised once, shared by the script below. */
const payload = JSON.stringify({ today, events, verifiedOn });
---

<section class="cal-hero">
  <div class="shell">
    <p class="cal-hero__eyebrow">What's on</p>
    <h1 class="cal-hero__title">What's on in Shenzhen</h1>
    <p class="cal-hero__lede">
      An English-language calendar of food festivals, markets, exhibitions and
      pop-ups across the city — written for people who don't read Chinese, and
      updated as new events are announced.
    </p>
  </div>
</section>

<div class="shell cal-body">
  <p class="cal-stats" data-stats>
    <span><strong data-count-total>{events.length}</strong> events listed</span>
    <span><strong data-count-live>{liveCount}</strong> on now</span>
    <span>Last verified <strong>{fmtDay(toDate(verifiedOn))}</strong></span>
  </p>

  <div class="cal-sub">
    <div class="cal-sub__copy">
      <h2 class="cal-sub__title">Get the calendar in your inbox</h2>
      <p class="cal-sub__note">
        A weekly digest every Thursday — what's on this weekend, nothing else.
      </p>
    </div>
    <div class="cal-sub__actions">
      <a class="btn btn--primary" href={`mailto:info@atlasofshenzhen.cn?subject=${encodeURIComponent("Subscribe to What's on in Shenzhen")}`}>
        Subscribe by email
      </a>
      <a class="cal-sub__ics" href="/calendar.ics" download>
        or subscribe in your calendar app (.ics)
      </a>
    </div>
  </div>

  <div class="cal-controls">
    <div class="cal-filters" role="group" aria-label="Filter events" data-filters>
      <button class="cal-chip is-active" data-filter="all" type="button">
        All <span data-filter-total>{events.length}</span>
      </button>
      <button class="cal-chip" data-filter="free" type="button">
        Free <span>{events.filter((e) => e.price_type !== "paid").length}</span>
      </button>
      {
        categories.map((c) => (
          <button class="cal-chip" data-filter={c.key} type="button">
            {c.label} <span>{c.count}</span>
          </button>
        ))
      }
    </div>

    <div class="cal-viewtoggle" role="group" aria-label="Choose view">
      <button class="is-active" data-view="list" type="button">List</button>
      <button data-view="month" type="button">Month</button>
    </div>
  </div>

  <!-- Server-rendered list. The script replaces this on filter / view change. -->
  <div id="view-list" class="cal-list">
    {
      upcoming.map((group) => {
        const d = toDate(group.key);
        const isToday = group.key === today;
        return (
          <div class="daygroup">
            <div class="daygroup__head">
              <span class="daygroup__date">{isToday ? "Today" : fmtDay(d)}</span>
              <span class="daygroup__weekday">{fmtWeekday(d)}</span>
              <span class="daygroup__count">
                {group.events.length} event{group.events.length > 1 ? "s" : ""}
              </span>
            </div>
            {group.events.map((e) => (
              <article
                class="event"
                data-id={e.id}
                tabindex="0"
                role="button"
                aria-label={`Details for ${e.title_en}`}
              >
                <div class="event__time">
                  <span class="event__run">
                    {fmtRange(toDate(e.start), toDate(e.end))}
                  </span>
                  <span class="event__clock">
                    {e.daily_time ?? "All day"}
                  </span>
                </div>
                <div class="event__body">
                  <div class="event__top">
                    <span class={`status status--${statusOf(e, today)}`}>
                      {STATUS_LABEL[statusOf(e, today)]}
                    </span>
                  </div>
                  <h3 class="event__title">{e.title_en}</h3>
                  {e.subtitle_en && (
                    <p class="event__sub">{e.subtitle_en}</p>
                  )}
                  <p class="event__where">
                    {e.venue_en}
                    {e.district ? ` · ${e.district}` : ""}
                  </p>
                  <div class="event__tags">
                    {e.price_type !== "paid" && (
                      <span class="tag tag--free">
                        Free
                        {e.price_type === "free_entry_paid_extras"
                          ? " entry"
                          : ""}
                      </span>
                    )}
                    {e.categories.map((c) => (
                      <span class="tag">{CATEGORY_LABEL[c] ?? c}</span>
                    ))}
                  </div>
                </div>
              </article>
            ))}
          </div>
        );
      })
    }

    {
      ended.length > 0 && (
        <div class="daygroup daygroup--past">
          <div class="daygroup__head">
            <span class="daygroup__date">Recently ended</span>
            <span class="daygroup__weekday" />
            <span class="daygroup__count">
              {ended.length} event{ended.length > 1 ? "s" : ""}
            </span>
          </div>
          {ended.map((e) => (
            <article
              class="event"
              data-id={e.id}
              tabindex="0"
              role="button"
              aria-label={`Details for ${e.title_en}`}
            >
              <div class="event__time">
                <span class="event__run">
                  {fmtRange(toDate(e.start), toDate(e.end))}
                </span>
                <span class="event__clock">{e.daily_time ?? "All day"}</span>
              </div>
              <div class="event__body">
                <div class="event__top">
                  <span class="status status--past">Ended</span>
                </div>
                <h3 class="event__title">{e.title_en}</h3>
                {e.subtitle_en && <p class="event__sub">{e.subtitle_en}</p>}
                <p class="event__where">
                  {e.venue_en}
                  {e.district ? ` · ${e.district}` : ""}
                </p>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>

  <div id="view-month" class="cal-month" hidden></div>

  <p class="cal-foot">
    <strong>{nowCount} of {events.length}</strong> listed events are still
    running or yet to start. Listings are extracted from Chinese-language
    event posters and checked by hand — dates, prices and opening hours can
    change at short notice, so always confirm with the organiser before
    travelling.
  </p>
</div>

<!-- Detail modal -->
<div class="cal-modal" id="cal-modal" hidden>
  <div class="cal-modal__scrim" data-close></div>
  <div
    class="cal-modal__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="cal-modal-title"
  >
    <button class="cal-modal__close" data-close type="button" aria-label="Close">
      ×
    </button>
    <div id="cal-modal-body"></div>
  </div>
</div>

<script type="application/json" id="cal-data" set:html={payload} />

<script>
  // ------------------------------------------------------------------
  // Calendar runtime. Re-derives every status against the visitor's real
  // clock, because a static build freezes the build date.
  // ------------------------------------------------------------------
  type Ev = {
    id: string;
    slug: string;
    title_en: string;
    title_zh?: string;
    subtitle_en?: string;
    start: string;
    end: string;
    daily_time?: string | null;
    venue_en: string;
    venue_zh?: string;
    district?: string;
    price_type: string;
    price_note?: string | null;
    categories: string[];
    summary_en?: string;
    highlights_en?: string[];
    organiser?: string;
    source?: string;
    flags?: string[];
    sub_events?: { title_en: string; date: string; times?: string[]; note?: string }[];
  };

  const raw = document.getElementById("cal-data")?.textContent ?? "{}";
  const data = JSON.parse(raw) as { today: string; events: Ev[]; verifiedOn: string };
  const EVENTS = data.events;

  // Never toISOString() — local parts only (see lib/calendar.ts).
  const dayKey = (d: Date) =>
    `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(
      d.getDate()
    ).padStart(2, "0")}`;

  const toDate = (iso: string) => {
    const [y, m, d] = iso.split("-").map(Number);
    return new Date(y, m - 1, d);
  };

  const NOW = dayKey(new Date()); // the visitor's today, not the build date

  const fmtDay = (d: Date) =>
    d.toLocaleDateString("en-GB", { day: "numeric", month: "long" });

  function fmtRange(a: Date, b: Date) {
    if (dayKey(a) === dayKey(b)) return fmtDay(a);
    const sameMonth =
      a.getMonth() === b.getMonth() && a.getFullYear() === b.getFullYear();
    return sameMonth ? `${a.getDate()}–${fmtDay(b)}` : `${fmtDay(a)} – ${fmtDay(b)}`;
  }

  const STATUS_LABEL: Record<string, string> = {
    live: "On now",
    soon: "This week",
    future: "Upcoming",
    past: "Ended",
  };

  function statusOf(ev: Ev) {
    const t = toDate(NOW), s = toDate(ev.start), e = toDate(ev.end);
    if (e < t) return "past";
    if (s <= t && t <= e) return "live";
    const days = Math.round((s.getTime() - t.getTime()) / 86400000);
    return days <= 7 ? "soon" : "future";
  }

  function daysOf(ev: Ev) {
    const out: Date[] = [];
    const s = toDate(ev.start), e = toDate(ev.end);
    for (let d = new Date(s); d <= e; d.setDate(d.getDate() + 1)) out.push(new Date(d));
    return out;
  }

  const CATEGORY_LABEL: Record<string, string> = {
    food: "Food", coffee: "Coffee", market: "Market", family: "Family",
    music: "Music", exhibition: "Exhibition", crafts: "Crafts",
  };

  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] as string)
    );

  let activeFilter = "all";

  function visible() {
    if (activeFilter === "all") return EVENTS;
    if (activeFilter === "free") return EVENTS.filter((e) => e.price_type !== "paid");
    return EVENTS.filter((e) => e.categories.includes(activeFilter));
  }

  /* ---------------- list ---------------- */
  function eventRow(e: Ev) {
    const st = statusOf(e);
    const free = e.price_type !== "paid";
    return `
      <article class="event" data-id="${esc(e.id)}" tabindex="0" role="button"
               aria-label="Details for ${esc(e.title_en)}">
        <div class="event__time">
          <span class="event__run">${fmtRange(toDate(e.start), toDate(e.end))}</span>
          <span class="event__clock">${esc(e.daily_time ?? "All day")}</span>
        </div>
        <div class="event__body">
          <div class="event__top">
            <span class="status status--${st}">${STATUS_LABEL[st]}</span>
          </div>
          <h3 class="event__title">${esc(e.title_en)}</h3>
          ${e.subtitle_en ? `<p class="event__sub">${esc(e.subtitle_en)}</p>` : ""}
          <p class="event__where">${esc(e.venue_en)}${e.district ? ` · ${esc(e.district)}` : ""}</p>
          <div class="event__tags">
            ${free ? `<span class="tag tag--free">Free${e.price_type === "free_entry_paid_extras" ? " entry" : ""}</span>` : ""}
            ${e.categories.map((c) => `<span class="tag">${CATEGORY_LABEL[c] ?? c}</span>`).join("")}
          </div>
        </div>
      </article>`;
  }

  function renderList() {
    const host = document.getElementById("view-list");
    if (!host) return;
    const evs = visible();
    if (!evs.length) {
      host.innerHTML = `<p class="cal-empty">Nothing matches that filter yet.</p>`;
      return;
    }

    const t = toDate(NOW);
    const groups = new Map<string, Ev[]>();
    const done: Ev[] = [];

    for (const e of evs) {
      const s = toDate(e.start), en = toDate(e.end);
      if (en < t) { done.push(e); continue; }
      // Anchor runs that already started to today, so a festival in progress
      // is not filed under a future date as if it opened then.
      const key = s < t ? NOW : dayKey(s);
      const list = groups.get(key);
      if (list) list.push(e); else groups.set(key, [e]);
    }

    const block = (key: string, list: Ev[]) => {
      const d = toDate(key);
      const isToday = key === NOW;
      return `
        <div class="daygroup">
          <div class="daygroup__head">
            <span class="daygroup__date">${isToday ? "Today" : fmtDay(d)}</span>
            <span class="daygroup__weekday">${d.toLocaleDateString("en-GB", { weekday: "long" })}</span>
            <span class="daygroup__count">${list.length} event${list.length > 1 ? "s" : ""}</span>
          </div>
          ${list.map(eventRow).join("")}
        </div>`;
    };

    done.sort((a, b) => toDate(b.start).getTime() - toDate(a.start).getTime());

    host.innerHTML =
      [...groups.entries()]
        .sort((a, b) => a[0].localeCompare(b[0]))
        .map(([k, l]) => block(k, l))
        .join("") +
      (done.length
        ? `<div class="daygroup daygroup--past">
             <div class="daygroup__head">
               <span class="daygroup__date">Recently ended</span>
               <span class="daygroup__weekday"></span>
               <span class="daygroup__count">${done.length} event${done.length > 1 ? "s" : ""}</span>
             </div>
             ${done.map(eventRow).join("")}
           </div>`
        : "");
  }

  /* ---------------- month ---------------- */
  function renderMonth() {
    const host = document.getElementById("view-month");
    if (!host) return;
    const evs = visible();
    const t = toDate(NOW);
    const months = [
      new Date(t.getFullYear(), t.getMonth(), 1),
      new Date(t.getFullYear(), t.getMonth() + 1, 1),
    ];

    host.innerHTML = months
      .map((m) => {
        const y = m.getFullYear(), mo = m.getMonth();
        const first = new Date(y, mo, 1);
        const pad = (first.getDay() + 6) % 7; // Monday-first
        const daysInMonth = new Date(y, mo + 1, 0).getDate();
        const cells = Math.ceil((pad + daysInMonth) / 7) * 7;

        let html = `<div class="month"><div class="month__head">${
          m.toLocaleDateString("en-GB", { month: "long", year: "numeric" })
        }</div><div class="monthgrid">`;
        html += ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
          .map((d) => `<div class="dow">${d}</div>`)
          .join("");

        for (let i = 0; i < cells; i++) {
          const dayNum = i - pad + 1;
          const inMonth = dayNum >= 1 && dayNum <= daysInMonth;
          const cell = new Date(y, mo, dayNum);
          const key = inMonth ? dayKey(cell) : null;

          const onDay = inMonth
            ? evs.filter((e) => daysOf(e).some((d) => dayKey(d) === key))
            : [];

          // Rank scarce (short) events first so a two-month exhibition cannot
          // crowd out a one-day market.
          const rank = [...onDay].sort(
            (a, b) =>
              daysOf(a).length - daysOf(b).length ||
              toDate(a.start).getTime() - toDate(b.start).getTime()
          );
          const shown = rank.slice(0, 3);
          const extra = onDay.length - shown.length;

          html += `<div class="day ${inMonth ? "" : "day--out"} ${
            key === NOW ? "day--today" : ""
          }">
            <span class="day__num">${cell.getDate()}</span>
            ${shown
              .map(
                (e) =>
                  `<span class="day__ev${
                    daysOf(e).length > 3 ? " day__ev--run" : ""
                  }" data-id="${esc(e.id)}" title="${esc(e.title_en)}">${esc(e.title_en)}</span>`
              )
              .join("")}
            ${extra > 0 ? `<span class="day__more">+${extra} more</span>` : ""}
          </div>`;
        }
        return html + `</div></div>`;
      })
      .join("");
  }

  /* ---------------- modal ---------------- */
  const modal = document.getElementById("cal-modal")!;
  const modalBody = document.getElementById("cal-modal-body")!;
  let lastFocus: HTMLElement | null = null;

  function openModal(id: string) {
    const e = EVENTS.find((x) => x.id === id);
    if (!e) return;
    const st = statusOf(e);
    const free = e.price_type !== "paid";

    modalBody.innerHTML = `
      <span class="status status--${st}">${STATUS_LABEL[st]}</span>
      <h2 class="cal-modal__title" id="cal-modal-title">${esc(e.title_en)}</h2>
      ${e.title_zh ? `<p class="cal-modal__zh">${esc(e.title_zh)}</p>` : ""}
      ${e.subtitle_en ? `<p class="cal-modal__sub">${esc(e.subtitle_en)}</p>` : ""}
      <dl class="cal-modal__facts">
        <dt>When</dt>
        <dd>${fmtRange(toDate(e.start), toDate(e.end))}${
          e.daily_time ? `<br><span class="dim">${esc(e.daily_time)} daily</span>` : ""
        }</dd>
        <dt>Where</dt>
        <dd>${esc(e.venue_en)}${e.district ? `, ${esc(e.district)}` : ""}${
          e.venue_zh ? `<br><span class="dim">${esc(e.venue_zh)}</span>` : ""
        }</dd>
        <dt>Cost</dt>
        <dd>${free ? (e.price_type === "free_entry_paid_extras" ? "Free entry" : "Free") : "Paid"}${
          e.price_note ? `<br><span class="dim">${esc(e.price_note)}</span>` : ""
        }</dd>
        ${e.organiser ? `<dt>Organiser</dt><dd>${esc(e.organiser)}</dd>` : ""}
      </dl>
      ${e.summary_en ? `<p class="cal-modal__about">${esc(e.summary_en)}</p>` : ""}
      ${
        e.highlights_en?.length
          ? `<h3 class="cal-modal__h3">Highlights</h3>
             <ul class="cal-modal__list">${e.highlights_en
               .map((h) => `<li>${esc(h)}</li>`)
               .join("")}</ul>`
          : ""
      }
      ${
        e.sub_events?.length
          ? `<h3 class="cal-modal__h3">Also on</h3>
             <ul class="cal-modal__list">${e.sub_events
               .map(
                 (s) =>
                   `<li><strong>${esc(s.title_en)}</strong> — ${fmtDay(
                     toDate(s.date)
                   )}${s.times ? `, ${esc(s.times.join(" / "))}` : ""}${
                     s.note ? `<br><span class="dim">${esc(s.note)}</span>` : ""
                   }</li>`
               )
               .join("")}</ul>`
          : ""
      }
      <p class="cal-modal__source">
        Source: ${esc(e.source ?? "—")} · Listing verified ${fmtDay(
      toDate(data.verifiedOn)
    )} · Always confirm with the organiser before travelling.
      </p>`;

    modal.hidden = false;
    document.body.style.overflow = "hidden";
    lastFocus = document.activeElement as HTMLElement;
    modal.querySelector<HTMLButtonElement>(".cal-modal__close")?.focus();
  }

  function closeModal() {
    modal.hidden = true;
    document.body.style.overflow = "";
    lastFocus?.focus();
  }

  /* ---------------- wiring ---------------- */
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;

    if (target.closest("[data-close]")) return closeModal();

    const evt = target.closest<HTMLElement>(".event, .day__ev");
    if (evt?.dataset.id) return openModal(evt.dataset.id);

    const chip = target.closest<HTMLButtonElement>("[data-filter]");
    if (chip) {
      activeFilter = chip.dataset.filter!;
      document
        .querySelectorAll("[data-filter]")
        .forEach((b) => b.classList.toggle("is-active", b === chip));
      renderList();
      if (!document.getElementById("view-month")!.hidden) renderMonth();
      return;
    }

    const view = target.closest<HTMLButtonElement>("[data-view]");
    if (view) {
      const which = view.dataset.view!;
      document
        .querySelectorAll("[data-view]")
        .forEach((b) => b.classList.toggle("is-active", b === view));
      document.getElementById("view-list")!.hidden = which !== "list";
      document.getElementById("view-month")!.hidden = which !== "month";
      if (which === "month") renderMonth();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !modal.hidden) closeModal();
    // Enter/Space on a focused event row opens it (the row is role=button).
    if ((e.key === "Enter" || e.key === " ") && !modal.hidden === false) {
      const el = document.activeElement as HTMLElement | null;
      if (el?.classList.contains("event") && el.dataset.id) {
        e.preventDefault();
        openModal(el.dataset.id);
      }
    }
  });

  // Correct the server-rendered statuses against the visitor's real date.
  // If the build date and today agree, nothing visible changes.
  if (NOW !== data.today) {
    renderList();
    document.querySelectorAll<HTMLElement>("[data-count-live]").forEach((el) => {
      el.textContent = String(
        EVENTS.filter((e) => statusOf(e) === "live").length
      );
    });
  }
</script>

