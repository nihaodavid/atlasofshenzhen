---
/**
 * YouTubeLite — click-to-play facade for a YouTube video.
 *
 * Why not a plain <iframe>? An embedded iframe pulls ~1MB of player JS on
 * every page view. The facade loads a static thumbnail (already used on the
 * listing page) and only swaps in the real player after a deliberate click.
 * This is the single biggest LCP win on video detail pages.
 *
 * Accessibility: the trigger is a real <button>, keyboard operable, with an
 * accessible name. Reduced-motion users get no animation.
 */
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
const poster = `https://i.ytimg.com/vi/${id}/maxresdefault.jpg`;
const posterFallback = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---

<div class="yt" data-youtube-id={id}>
  <button class="yt__trigger" type="button" aria-label={`Play video: ${title}`}>
    <img
      class="yt__thumb"
      src={poster}
      alt=""
      width="1280"
      height="720"
      loading="lazy"
      decoding="async"
      onerror={`this.onerror=null;this.src='${posterFallback}'`}
    />
    <span class="yt__play" aria-hidden="true">
      <svg width="68" height="68" viewBox="0 0 68 68">
        <circle cx="34" cy="34" r="33" fill="rgba(0,0,0,0.55)" stroke="#fff" stroke-width="2" />
        <path d="M27 21 50 34 27 47Z" fill="#fff" />
      </svg>
    </span>
  </button>
  <noscript>
    <a class="yt__fallback" href={`https://www.youtube.com/watch?v=${id}`}>
      Watch “{title}” on YouTube
    </a>
  </noscript>
</div>

<script>
  // Replace the facade with the real iframe only on user intent.
  document.querySelectorAll<HTMLElement>("[data-youtube-id]").forEach((root) => {
    const btn = root.querySelector<HTMLButtonElement>(".yt__trigger");
    btn?.addEventListener("click", () => {
      const id = root.dataset.youtubeId;
      if (!id) return;
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = btn.getAttribute("aria-label")?.replace("Play video: ", "") ?? "";
      iframe.allow =
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      iframe.allowFullscreen = true;
      iframe.loading = "lazy";
      iframe.className = "yt__iframe";
      root.replaceChildren(iframe);
    });
  });
</script>

<style>
  .yt {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .yt__trigger {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .yt__thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .yt__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transition: transform 0.25s var(--ease);
  }

  .yt__trigger:hover .yt__play {
    transform: scale(1.08);
  }

  .yt__iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .yt__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--teal);
    color: var(--white);
    text-align: center;
    padding: 1rem;
  }
</style>
