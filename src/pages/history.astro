---
import CollectionLayout from "../layouts/CollectionLayout.astro";
import { getPage } from "../lib/content";
import { breadcrumbs, collectionPage } from "../lib/schema";

const page = getPage("history");
---

<CollectionLayout
  slug="history"
  title="History"
  description={page.meta.description || "Long-form research on the places, railways, villages and industries that shaped Shenzhen."}
  heroHeading="History"
  cards={page.cards ?? []}
  blocks={page.blocks}
  schema={[
    collectionPage({ name: "History", description: page.meta.description || "History at the Atlas of Shenzhen.", path: "/history/" }),
    breadcrumbs([
      { name: "Home", path: "/" },
      { name: "Opinions", path: "/future-works-1/" },
      { name: "History", path: "/history/" },
    ]),
  ]}
/>
