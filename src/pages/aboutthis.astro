---
import FluidPageLayout from "../layouts/FluidPageLayout.astro";
import { getPage } from "../lib/content";
import { breadcrumbs } from "../lib/schema";

const page = getPage("aboutthis");
---

<FluidPageLayout
  slug="aboutthis"
  title="Vision & Mission"
  description={page.meta.description || "The Atlas of Shenzhen is a comprehensive and innovative statement concerning the geography, history and industrial prospects of the city of Shenzhen."}
  heroHeading="Vision & Mission"
  blocks={page.blocks}
  schema={[
    {
      "@context": "https://schema.org",
      "@type": "AboutPage",
      name: "Vision & Mission",
      description: page.meta.description || "Vision & Mission at the Atlas of Shenzhen.",
      url: new URL("/aboutthis/", Astro.site).href,
    },
    breadcrumbs([
      { name: "Home", path: "/" },
      { name: "About", path: "/aboutthis/" },
    ]),
  ]}
/>
