---
/**
 * Video detail page — /videos/v/<slug>/
 *
 * Statically generated for all 40 videos from the extracted content.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import YouTubeLite from "../../../components/YouTubeLite.astro";
import { getAllItems, type ItemDoc } from "../../../lib/content";

export function getStaticPaths() {
  return getAllItems()
    .filter((i) => i.type === "video")
    .map((item) => {
      // The original URL is /videos/v/<perma-id>. Preserve it exactly so no
      // inbound link or search result breaks. `item.slug` is an internal
      // flattening ("videos--v--<id>") and must not appear in a URL.
      const permaId = item.path.replace(/^\/videos\/v\//, "");
      return { params: { slug: permaId }, props: { item } };
    });
}

interface Props {
  item: ItemDoc;
}

const { item } = Astro.props;
const description =
  item.description || item.meta.description || `Watch “${item.title}” on the Atlas of Shenzhen.`;
---

<BaseLayout
  title={item.title}
  description={description}
  current="/videos/"
  ogImage={`https://i.ytimg.com/vi/${item.youtubeId}/maxresdefault.jpg`}
>
  <article class="section">
    <div class="shell video-detail">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/videos/">Videos</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{item.title}</span>
      </nav>

      {
        item.youtubeId ? (
          <YouTubeLite id={item.youtubeId} title={item.title} />
        ) : (
          <p class="video-detail__missing">
            This video is not available to embed. Please check back later.
          </p>
        )
      }

      <header class="video-detail__header">
        {
          (item.categories ?? []).length > 0 && (
            <ul class="video-detail__cats" role="list">
              {item.categories!.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          )
        }
        <h1>{item.title}</h1>
        {item.description && <p class="video-detail__desc">{item.description}</p>}
      </header>

      {
        (item.related ?? []).length > 0 && (
          <section class="video-detail__related">
            <h2>Related videos</h2>
            <ul role="list">
              {item.related!.map((r) => (
                <li>
                  <a href={`${r.href}/`}>{r.title}</a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .video-detail {
    max-width: 960px;
  }

  .crumbs {
    display: flex;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--ink-muted);
    margin-bottom: 1.5rem;
  }

  .crumbs a:hover {
    color: var(--teal);
  }

  .video-detail__header {
    margin-top: 2rem;
  }

  .video-detail__cats {
    list-style: none;
    padding: 0;
    display: flex;
    gap: 0.5rem;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 0.75rem;
  }

  .video-detail__desc {
    margin-top: 1.25rem;
    font-size: 1.0625rem;
    color: var(--ink-soft);
    max-width: var(--measure);
  }

  .video-detail__missing {
    padding: 3rem;
    background: var(--surface);
    border-radius: var(--radius);
    text-align: center;
    color: var(--ink-muted);
  }

  .video-detail__related {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .video-detail__related ul {
    list-style: none;
    padding: 0;
    margin-top: 1rem;
    display: grid;
    gap: 0.6rem;
  }

  .video-detail__related a:hover {
    color: var(--teal-dark);
  }
</style>
