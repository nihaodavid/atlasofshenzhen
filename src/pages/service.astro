---
import CollectionLayout from "../layouts/CollectionLayout.astro";
import { getPage } from "../lib/content";
import { breadcrumbs, collectionPage } from "../lib/schema";

const page = getPage("service");
---

<CollectionLayout
  slug="service"
  title="Service"
  description={page.meta.description || "Sector briefings on logistics, manufacturing, education and sustainable development."}
  heroHeading="Service"
  cards={page.cards ?? []}
  blocks={page.blocks}
  schema={[
    collectionPage({ name: "Service", description: page.meta.description || "Service at the Atlas of Shenzhen.", path: "/service/" }),
    breadcrumbs([
      { name: "Home", path: "/" },
      { name: "Opinions", path: "/future-works-1/" },
      { name: "Service", path: "/service/" },
    ]),
  ]}
/>
