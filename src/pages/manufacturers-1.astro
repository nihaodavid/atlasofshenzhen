---
import CollectionLayout from "../layouts/CollectionLayout.astro";
import { getPage } from "../lib/content";
import { breadcrumbs, collectionPage } from "../lib/schema";

const page = getPage("manufacturers-1");
---

<CollectionLayout
  slug="manufacturers-1"
  title="Manufacturers"
  description={page.meta.description || "A directory of manufacturers and industrial clusters across Shenzhen and the Greater Bay Area."}
  heroHeading="Manufacturers"
  cards={page.cards ?? []}
  blocks={page.blocks}
  schema={[
    collectionPage({ name: "Manufacturers", description: page.meta.description || "Manufacturers at the Atlas of Shenzhen.", path: "/manufacturers-1/" }),
    breadcrumbs([
      { name: "Home", path: "/" },
      { name: "Opinions", path: "/future-works-1/" },
      { name: "Manufacturers", path: "/manufacturers-1/" },
    ]),
  ]}
/>
