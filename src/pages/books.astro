---
import CollectionLayout from "../layouts/CollectionLayout.astro";
import { getPage } from "../lib/content";
import { breadcrumbs, collectionPage } from "../lib/schema";

const page = getPage("books");
---

<CollectionLayout
  slug="books"
  title="Books"
  description={page.meta.description || "Reading notes and reviews on Shenzhen, its libraries, publishers and reading culture."}
  heroHeading="Books"
  cards={page.cards ?? []}
  blocks={page.blocks}
  schema={[
    collectionPage({ name: "Books", description: page.meta.description || "Books at the Atlas of Shenzhen.", path: "/books/" }),
    breadcrumbs([
      { name: "Home", path: "/" },
      { name: "Opinions", path: "/future-works-1/" },
      { name: "Books", path: "/books/" },
    ]),
  ]}
/>
