---
import FluidPageLayout from "../layouts/FluidPageLayout.astro";
import { getPage } from "../lib/content";
import { breadcrumbs } from "../lib/schema";

const page = getPage("join-us");
---

<FluidPageLayout
  slug="join-us"
  title="Join Us"
  description={page.meta.description || "Contribute writing, photography, translation or research to the Atlas of Shenzhen."}
  heroHeading="Join Us"
  blocks={page.blocks}
  schema={[
    breadcrumbs([
      { name: "Home", path: "/" },
      { name: "About", path: "/aboutthis/" },
      { name: "Join Us", path: "/join-us/" },
    ]),
  ]}
/>
