---
/**
 * Article detail page for every blog-style collection.
 *
 * Route shape: /[collection]/[slug]/
 *   e.g. /history/kowloon-canton-railway/, /service/coffee/,
 *        /manufacturers-1/travel-luggage/, /nature/bougainvillea/
 *
 * The collection slug is taken from the item's original path, so migrated
 * URLs stay identical to the Squarespace site.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllItems, type ItemDoc } from "../../lib/content";
import { article, breadcrumbs } from "../../lib/schema";

const COLLECTION_TITLES: Record<string, string> = {
  history: "History",
  books: "Books",
  nature: "Nature",
  service: "Service",
  "manufacturers-1": "Manufacturers",
};

export function getStaticPaths() {
  return getAllItems()
    .filter((i) => i.type === "article")
    .map((item) => {
      // "/history/<slug>" -> collection "history", slug "<slug>"
      const parts = item.path.replace(/^\//, "").split("/");
      const collection = parts[0];
      const postSlug = parts.slice(1).join("/") || item.slug;
      return { params: { collection, slug: postSlug }, props: { item } };
    });
}

interface Props {
  item: ItemDoc;
}

const { item } = Astro.props;
const parts = item.path.replace(/^\//, "").split("/");
const collection = parts[0];
const collectionTitle = COLLECTION_TITLES[collection] ?? collection;

const plain = (item.body ?? []).map((b) => b.text).join(" ");
const description =
  item.meta.description ||
  (plain.length > 158 ? plain.slice(0, 155).trimEnd() + "…" : plain) ||
  `${item.title} — ${collectionTitle} at the Atlas of Shenzhen.`;

// Render the body, grouping consecutive list items into a single <ul> and
// numbering inline figures ("Figure 1", "Figure 2", …) in document order.
type FigNode = {
  type: "figure";
  src: string;
  caption?: string;
  alt?: string;
  wide?: boolean;
  number: number;
};
type Node =
  | { type: string; level?: number; text: string }
  | { type: "list"; items: string[] }
  | FigNode;

const nodes: Node[] = [];
let figureCount = 0;
for (const b of item.body ?? []) {
  const last = nodes[nodes.length - 1];
  if (b.type === "listitem" && last && last.type === "list") {
    last.items.push(b.text);
  } else if (b.type === "listitem") {
    nodes.push({ type: "list", items: [b.text] });
  } else if (b.type === "figure" && b.src) {
    figureCount += 1;
    nodes.push({
      type: "figure",
      src: b.src,
      caption: b.caption,
      alt: b.alt,
      wide: b.wide,
      number: figureCount,
    });
  } else {
    nodes.push(b);
  }
}

// Inline figures carry their own captions, so only images that were declared
// in `item.images` without a matching figure block belong in the end gallery.
const inlineSources = new Set(
  nodes.filter((n): n is FigNode => n.type === "figure").map((n) => n.src),
);
const bodyImages = (item.images ?? []).filter((src) => !inlineSources.has(src));

// Lead image, then gallery. When every image in an article is already shown
// inline as a figure, `bodyImages` is empty and there is no separate lead
// image to print: the og:image in that case is a social-card rendering of the
// very chart the first figure already displays, so falling back to it would
// show the reader the same picture twice. Articles with a real gallery image
// are unaffected.
const heroImage = bodyImages[0] ?? null;
const galleryImages = bodyImages.slice(1);

// Canonical on-site path — identical to the legacy CMS permalink by design.
const canonicalPath = `/${collection}/${parts.slice(1).join("/") || item.slug}/`;

// Social cards must be a raster format — Facebook, X/Slack/WeChat do not
// render SVG og:images. Fall back to the first raster image in the body, and
// only then to the chart SVG.
const RASTER = /\.(png|jpe?g|webp|gif|avif)$/i;
const rasterInBody = bodyImages.find((src) => RASTER.test(src));
const socialImage = item.meta.ogImage || rasterInBody || heroImage;
---

<BaseLayout
  title={item.title}
  description={description}
  current={`/${collection}/`}
  ogImage={socialImage}
  schema={[
    article({
      headline: item.title,
      description,
      path: canonicalPath,
      // Use the same raster-safe image the social card uses: Google also
      // rejects SVG for Article.image.
      image: socialImage ? new URL(socialImage, Astro.site).href : undefined,
      datePublished: item.date,
    }),
    breadcrumbs([
      { name: "Home", path: "/" },
      { name: collectionTitle, path: `/${collection}/` },
      { name: item.title, path: canonicalPath },
    ]),
  ]}
>
  <article class="section">
    <div class="shell article">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={`/${collection}/`}>{collectionTitle}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{item.title}</span>
      </nav>

      <header class="article__header">
        <h1>{item.title}</h1>
        {
          (item.date || item.author) && (
            <p class="article__meta">
              {[item.date, item.author && `Written by ${item.author}`]
                .filter(Boolean)
                .join(" · ")}
            </p>
          )
        }
      </header>

      {
        heroImage && (
          <img
            class="article__hero"
            src={heroImage}
            alt={item.title ? `${item.title} — lead image` : "Article lead image"}
            width="1200"
            height="675"
            loading="eager"
            decoding="async"
          />
        )
      }

      <div class="prose article__body">
        {
          nodes.map((n) => {
            if (n.type === "list") {
              return (
                <ul>
                  {n.items.map((i) => (
                    <li>{i}</li>
                  ))}
                </ul>
              );
            }
            if (n.type === "figure") {
              return (
                <figure class={`fig${n.wide ? " fig--wide" : ""}`}>
                  <img
                    src={n.src}
                    alt={n.alt ?? n.caption ?? `Figure ${n.number}`}
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>
                    <span class="fig__num">Figure {n.number}</span>
                    {n.caption && <span class="fig__text">{n.caption}</span>}
                  </figcaption>
                </figure>
              );
            }
            if (n.type === "heading") {
              const Tag = `h${Math.min(Math.max(n.level ?? 2, 2), 4)}` as const;
              return <Tag>{n.text}</Tag>;
            }
            if (n.type === "quote") return <blockquote>{n.text}</blockquote>;
            return <p>{n.text}</p>;
          })
        }
      </div>

      {
        galleryImages.length > 0 && (
          <section class="article__gallery">
            <h2>Images</h2>
            <ul role="list">
              {galleryImages.map((src, i) => (
                <li>
                  <img
                    src={src}
                    alt={
                      item.title
                        ? `${item.title} — image ${i + 2}`
                        : `Article image ${i + 2}`
                    }
                    loading="lazy"
                    decoding="async"
                  />
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <footer class="article__footer">
        <a class="btn btn--outline" href={`/${collection}/`}>
          ← Back to {collectionTitle}
        </a>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    max-width: 780px;
  }

  .crumbs {
    display: flex;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--ink-muted);
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
  }

  .crumbs a:hover {
    color: var(--teal);
  }

  .article__header h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }

  .article__meta {
    margin-top: 0.85rem;
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  .article__hero {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    margin-top: 2.25rem;
  }

  .article__body {
    margin-top: 2.5rem;
  }

  /* ---- inline figures -------------------------------------------------- */
  .fig {
    margin: 2.75rem 0;
  }

  .fig img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: #fff;
  }

  .fig figcaption {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    margin-top: 0.85rem;
    padding-left: 0.15rem;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .fig__num {
    flex: none;
    font-weight: 600;
    color: var(--teal);
    letter-spacing: 0.01em;
  }

  .fig__text {
    min-width: 0;
  }

  /* Wide charts may safely break out of the 780px prose column. */
  .fig--wide {
    width: min(100%, 980px);
    margin-left: 50%;
    transform: translateX(-50%);
  }

  @media (max-width: 860px) {
    .fig--wide {
      width: 100%;
      margin-left: 0;
      transform: none;
    }
  }

  .article__gallery {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .article__gallery ul {
    list-style: none;
    padding: 0;
    margin-top: 1.25rem;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
  }

  .article__gallery img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .article__footer {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
</style>
