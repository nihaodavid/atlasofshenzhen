---
import FluidPageLayout from "../layouts/FluidPageLayout.astro";
import { getPage } from "../lib/content";
import { breadcrumbs } from "../lib/schema";

const page = getPage("team");
---

<FluidPageLayout
  slug="team"
  title="Team"
  description={page.meta.description || "Meet the researchers, writers, translators and designers behind the Atlas of Shenzhen."}
  heroHeading="Team"
  blocks={page.blocks}
  schema={[
    breadcrumbs([
      { name: "Home", path: "/" },
      { name: "About", path: "/aboutthis/" },
      { name: "Team", path: "/team/" },
    ]),
  ]}
/>
