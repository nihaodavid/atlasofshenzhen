---
/**
 * BaseLayout — shared shell for every page.
 *
 * Handles: document head + SEO meta, skip link, header with accessible
 * dropdown navigation, and footer contact block.
 */
import "../styles/global.css";
import { SITE, NAV } from "../site.config";

interface Props {
  title: string;
  description?: string;
  /** Path of the current page, e.g. "/videos/" — used for nav highlighting. */
  current?: string;
  ogImage?: string;
}

const {
  title,
  description = SITE.description,
  current = "/",
  ogImage,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title === SITE.name ? title : `${title} — ${SITE.shortName}`;
const ogImageUrl = ogImage
  ? new URL(ogImage, Astro.site).href
  : new URL("/images/og-default.jpg", Astro.site).href;

/** True when `href` matches the current page or one of its children. */
function isActive(href: string, children?: { href: string }[]): boolean {
  if (href === "/") return current === "/";
  if (current.startsWith(href)) return true;
  return (children ?? []).some((c) => current.startsWith(c.href));
}
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/images/logo.jpg" />

    <!-- Fonts: Manrope is a free, metrically-similar stand-in for the
         original "gopher" Typekit face, whose licence is bound to the
         Squarespace account. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600&display=swap"
    />

    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="shell site-header__inner">
        <a class="site-header__brand" href="/" aria-label={`${SITE.name} — home`}>
          <picture>
            <source srcset="/images/logo.webp" type="image/webp" />
            <img
              src="/images/logo.jpg"
              alt="The Atlas of Shenzhen logo"
              width="150"
              height="71"
              loading="eager"
            />
          </picture>
        </a>

        <nav class="site-nav" aria-label="Main">
          <ul class="site-nav__list">
            {
              NAV.map((item) =>
                item.children ? (
                  <li class="site-nav__item site-nav__item--has-children">
                    <button
                      class="site-nav__link site-nav__link--toggle"
                      aria-expanded="false"
                      aria-haspopup="true"
                      data-dropdown-toggle
                      type="button"
                    >
                      {item.label}
                      <svg
                        class="site-nav__chevron"
                        width="10"
                        height="10"
                        viewBox="0 0 10 10"
                        aria-hidden="true"
                      >
                        <path
                          d="M1 3.5 5 7.5 9 3.5"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </button>
                    <ul class="site-nav__dropdown">
                      {item.children.map((child) => (
                        <li>
                          <a
                            class="site-nav__dropdown-link"
                            href={child.href}
                            aria-current={
                              current.startsWith(child.href) ? "page" : undefined
                            }
                          >
                            {child.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </li>
                ) : (
                  <li class="site-nav__item">
                    <a
                      class="site-nav__link"
                      href={item.href}
                      aria-current={isActive(item.href) ? "page" : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                )
              )
            }
          </ul>

          <button
            class="site-nav__burger"
            aria-expanded="false"
            aria-controls="mobile-nav"
            aria-label="Open menu"
            type="button"
            data-burger
          >
            <span></span><span></span><span></span>
          </button>
        </nav>
      </div>

      <!-- Mobile drawer -->
      <div class="mobile-nav" id="mobile-nav" hidden>
        <ul class="mobile-nav__list">
          {
            NAV.map((item) => (
              <li>
                <a class="mobile-nav__link" href={item.href}>
                  {item.label}
                </a>
                {item.children && (
                  <ul class="mobile-nav__sublist">
                    {item.children.map((child) => (
                      <li>
                        <a class="mobile-nav__sublink" href={child.href}>
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </header>

    <main id="main" class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell site-footer__inner">
        <div class="site-footer__contact">
          <a class="site-footer__email" href={`mailto:${SITE.email}`}>
            {SITE.email}
          </a>
          <address class="site-footer__address">
            {SITE.address.map((line) => <span>{line}</span>)}
          </address>
        </div>
        <p class="site-footer__copy">
          &copy; {new Date().getFullYear()}
          {SITE.name}
        </p>
      </div>
    </footer>

    <script>
      // --- Header navigation: dropdowns + mobile drawer -------------------
      // Kept dependency-free so the header works before any hydration.
      const toggles = document.querySelectorAll<HTMLButtonElement>(
        "[data-dropdown-toggle]"
      );

      function closeAll(except?: Element) {
        toggles.forEach((t) => {
          if (t === except) return;
          t.setAttribute("aria-expanded", "false");
          t.closest(".site-nav__item")?.classList.remove("is-open");
        });
      }

      toggles.forEach((toggle) => {
        toggle.addEventListener("click", (e) => {
          e.stopPropagation();
          const open = toggle.getAttribute("aria-expanded") === "true";
          closeAll(toggle);
          toggle.setAttribute("aria-expanded", String(!open));
          toggle.closest(".site-nav__item")?.classList.toggle("is-open", !open);
        });

        // Close when focus leaves the dropdown entirely (keyboard users).
        const item = toggle.closest(".site-nav__item");
        item?.addEventListener("focusout", (e) => {
          const next = (e as FocusEvent).relatedTarget as Node | null;
          if (next && item.contains(next)) return;
          toggle.setAttribute("aria-expanded", "false");
          item.classList.remove("is-open");
        });
      });

      document.addEventListener("click", () => closeAll());
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeAll();
      });

      const burger = document.querySelector<HTMLButtonElement>("[data-burger]");
      const drawer = document.getElementById("mobile-nav");
      burger?.addEventListener("click", () => {
        const open = burger.getAttribute("aria-expanded") === "true";
        burger.setAttribute("aria-expanded", String(!open));
        burger.setAttribute("aria-label", open ? "Open menu" : "Close menu");
        drawer?.toggleAttribute("hidden", open);
        document.body.classList.toggle("nav-open", !open);
      });
    </script>
  </body>
</html>

<style>
  /* ---------------- Header ---------------- */
  .site-header {
    background: var(--white);
    border-bottom: 1px solid transparent;
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 88px;
  }

  .site-header__brand img {
    width: clamp(120px, 15vw, 150px);
    height: auto;
  }

  /* ---------------- Desktop nav ---------------- */
  .site-nav__list {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
    list-style: none;
    padding: 0;
  }

  .site-nav__item {
    position: relative;
  }

  .site-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: none;
    border: 0;
    padding: 0.4rem 0;
    font-size: 0.9375rem;
    color: var(--ink);
    cursor: pointer;
    position: relative;
  }

  /* Underline indicator, matching the original site's active state */
  .site-nav__link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1.5px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }

  .site-nav__link:hover::after,
  .site-nav__link[aria-current="page"]::after,
  .site-nav__item.is-open > .site-nav__link::after {
    transform: scaleX(1);
  }

  .site-nav__chevron {
    transition: transform 0.25s var(--ease);
  }

  .site-nav__item.is-open .site-nav__chevron {
    transform: rotate(180deg);
  }

  /* ---------------- Dropdown ---------------- */
  .site-nav__dropdown {
    position: absolute;
    top: calc(100% + 0.75rem);
    left: 50%;
    translate: -50% 0;
    min-width: 210px;
    list-style: none;
    padding: 0.5rem;
    margin: 0;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.2s var(--ease), transform 0.2s var(--ease),
      visibility 0.2s;
  }

  .site-nav__item.is-open .site-nav__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .site-nav__dropdown-link {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 4px;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .site-nav__dropdown-link:hover,
  .site-nav__dropdown-link[aria-current="page"] {
    background: var(--teal-tint);
    color: var(--teal-dark);
  }

  /* ---------------- Burger + drawer ---------------- */
  .site-nav__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 0;
  }

  .site-nav__burger span {
    display: block;
    width: 22px;
    height: 1.5px;
    margin-inline: auto;
    background: var(--ink);
    transition: transform 0.25s var(--ease), opacity 0.25s var(--ease);
  }

  .site-nav__burger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .site-nav__burger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .site-nav__burger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  .mobile-nav {
    border-top: 1px solid var(--border);
    background: var(--white);
    max-height: calc(100dvh - 88px);
    overflow-y: auto;
  }

  .mobile-nav__list,
  .mobile-nav__sublist {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .mobile-nav__list {
    padding: 1rem var(--gutter) 2rem;
  }

  .mobile-nav__link {
    display: block;
    padding: 0.75rem 0;
    font-size: 1.0625rem;
    border-bottom: 1px solid var(--border);
  }

  .mobile-nav__sublink {
    display: block;
    padding: 0.55rem 0 0.55rem 1rem;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  @media (max-width: 860px) {
    .site-nav__list {
      display: none;
    }
    .site-nav__burger {
      display: flex;
    }
  }

  .site-main {
    flex: 1;
  }

  /* ---------------- Footer ---------------- */
  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
    margin-top: auto;
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .site-footer__email {
    display: inline-block;
    font-size: 1.125rem;
    color: var(--ink);
    margin-bottom: 0.75rem;
  }

  .site-footer__email:hover {
    color: var(--teal);
  }

  .site-footer__address {
    font-style: normal;
    display: flex;
    flex-direction: column;
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .site-footer__copy {
    font-size: 0.8125rem;
    color: var(--ink-muted);
  }
</style>
